{
  "extends": "base.json",
  "output_path": "./results/lebo_apex_grid",
  "grid": {
    "method": [
      "lebo",
      "lpbebo",
      "lams",
      "tandem",
      "move",
      "random_walker",
      "random_mutang"
    ],
    "evaluation_budget": [1400],
    "apex.mic_aggregate": ["mean"],
    "apex.mic_bacteria": [[1, 2, 3]],
    "encoder.jacobian_mode": ["approx"],
    "encoder.default_condition": [[1.0, 1.0]],
    "encoder.temperature": [1.0],
    "encoder.jacobian_eps": [0.05],
    "encoder.field_eps": [0.05],
    "mutation.max_len": [25],
    "mutation.direction_significance_threshold": [0.001],
    "mutation.min_number_of_directions": [5],
    "mutation.token_threshold": [0.1],
    "walker.horizontal_threshold": [0.1],
    "walker.time_step": [0.01],
    "walker.max_horizontal_update_norm": [0.5],
    "walker.vertical_movement": [true],
    "local_enumeration.walker_trajectories": [10],
    "local_enumeration.walk_time_budget": [0.1],
    "local_enumeration.max_neighbour_levenshtein": [4],
    "filter.maximum_candidates": [6000],
    "filter.top_p": [0.9],
    "filter.temperature": [1.0],
    "filter.similarity_threshold": [0.15],
    "filter.selection_fraction": [0.6],
    "filter.maximum_positions": [5],
    "filter.residues_per_position": [4],
    "optimizer.initial_peptides": [1],
    "optimizer.best_as_center": [false],
    "optimizer.acquisition_batch_size": [32],
    "optimizer.standardize": [false],
    "optimizer.levenshtein_diversity_threshold": [2],
    "optimizer.evaluations_per_iteration": [3],
    "optimizer.turbo_success_tolerance": [100],
    "optimizer.turbo_failure_tolerance": [1],
    "optimizer.turbo_length_init": [2],
    "optimizer.turbo_length_min": [2],
    "optimizer.turbo_length_max": [2],
    "optimizer.blosum_diversity_matrix": [null],
    "optimizer.blosum_diversity_max_score": [null]
  }
}
